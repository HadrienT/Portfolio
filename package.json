	"devDependencies": {
		"@eslint/js": "^9.39.0",
		"@tailwindcss/vite": "^4.0.3",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.2.0",
		"@types/node": "^22.13.1",
		"@types/react": "^19.0.8",
		"@types/react-dom": "^19.0.3",
